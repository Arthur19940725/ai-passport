# Export these variables into the process environment; this file is not loaded
# automatically. Never commit the real device token or OAuth access tokens.
# Launch from the repository root: python -m gateway.grok_bot.server
# Exactly one process/worker: state and pending commands exist only in memory.
# A separately configured HTTPS reverse proxy must preserve the public Host,
# strip untrusted forwarding headers, and proxy to 127.0.0.1:8080.
PASSPORT_PUBLIC_URL=https://passport.example.com/mcp
PASSPORT_PORT=8080
PASSPORT_DEVICE_ID=passport-01
# Generate at least 32 random URL-safe characters and provision the same secret
# on this server and the device. The empty default deliberately prevents startup.
PASSPORT_DEVICE_TOKEN=
# External OAuth authorization server, not a Grok API or a homegrown login flow.
# It must support the Bot client's OAuth flow and issue RS256 JWT access tokens
# with aud exactly PASSPORT_PUBLIC_URL and scope containing passport:control.
PASSPORT_OAUTH_ISSUER=https://identity.example.com/
PASSPORT_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Exact owner 'sub' claim. Only this subject may use this single-device server.
# JWT access tokens must also contain a nonempty client_id or azp claim.
PASSPORT_OAUTH_SUBJECT=
# Comma-separated exact HTTPS browser origins if needed; no wildcard. Empty
# allows clients without an Origin header and rejects all browser origins.
PASSPORT_ALLOWED_ORIGINS=
